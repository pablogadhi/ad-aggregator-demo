# Pins for the Flux bootstrap (scripts/flux.sh). Everything else is pinned inside the Flux manifests.
FLUX_OPERATOR_CHART=oci://ghcr.io/controlplaneio-fluxcd/charts/flux-operator
FLUX_OPERATOR_CHART_VERSION=0.60.0          # operator v0.60.0 (web UI on :9080)
FLUX_CLI_IMAGE=ghcr.io/fluxcd/flux-cli:v2.9.5   # pushes the infra/ artifact; `scripts/flux.sh <args>` wraps it
BEDAG_RAW_CHART_VERSION=2.0.2               # release flux-bootstrap (FluxInstance + web UI RBAC)
# Flux distribution: spec.distribution.version in flux-instance.yaml (2.9.5)

# The artifact Flux syncs: pushed from the host over the kind network, pulled in-cluster by
# source-controller (pods resolve the registry container by name; plain HTTP -> insecure).
SDL_ARTIFACT=oci://sdl-registry:5000/sdl-infra
SDL_ARTIFACT_TAG=latest
